---
interface Props {
  title: string;
  subtitle?: string;
  variant?: 'default' | 'image';
  imageSrc?: string;
  imageAlt?: string;
  /** CSS object-position for the image, e.g. `center 35%` */
  imagePosition?: string;
  /** Parallax scroll on background image */
  imageParallax?: boolean;
  /** Scales min-height and padding on image heroes (e.g. 1.25 = 25% taller) */
  heroScale?: number;
}

const {
  title,
  subtitle,
  variant = 'default',
  imageSrc,
  imageAlt = '',
  imagePosition = 'center',
  imageParallax = false,
  heroScale = 1,
} = Astro.props;

const useParallaxImage = variant === 'image' && imageSrc && imageParallax;

const imageHeroStyle =
  variant === 'image' && imageSrc && !useParallaxImage
    ? [
        `background-image: url(${imageSrc})`,
        `background-position: ${imagePosition}`,
        heroScale !== 1 ? `--page-hero-scale: ${heroScale}` : '',
      ]
        .filter(Boolean)
        .join('; ')
    : heroScale !== 1
      ? `--page-hero-scale: ${heroScale}`
      : undefined;
---

<section
  class:list={[
    'page-hero',
    variant === 'image' && 'page-hero--image',
    useParallaxImage && 'page-hero--parallax',
  ]}
  style={imageHeroStyle}
>
  {
    useParallaxImage && (
      <div class="page-hero__bg" aria-hidden="true">
        <div class="page-hero__media-clip">
          <div class="page-hero__parallax" data-page-hero-parallax>
            <img
              src={imageSrc}
              alt={imageAlt}
              width="1600"
              height="900"
              loading="eager"
              decoding="async"
              style={`object-position: ${imagePosition}`}
            />
          </div>
          <div class="page-hero__overlay"></div>
        </div>
      </div>
    )
  }

  <div class="container page-hero__content">
    <h1 class:list={[variant === 'default' && 'hero-title', variant === 'image' && 'page-hero__title-image']}>
      {title}
    </h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
</section>

{
  useParallaxImage && (
    <script is:inline>
      {`
(() => {
  const init = () => {
    const hero = document.querySelector('.page-hero--parallax');
    if (!hero) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const parallaxLayer = hero.querySelector('[data-page-hero-parallax]');
    if (reduceMotion || !parallaxLayer) return;

    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const rect = hero.getBoundingClientRect();
        const vh = window.innerHeight || 1;
        const total = rect.height + vh;
        const passed = vh - rect.top;
        const progress = Math.min(1, Math.max(0, passed / total));
        const maxShift = Math.max(100, rect.height * 0.22);
        const offset = maxShift - progress * 2 * maxShift;
        const img = parallaxLayer.querySelector('img');
        if (img) {
          img.style.transform = \`translate3d(0, calc(15% + \${offset}px), 0)\`;
        }
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  };

  init();
  document.addEventListener('astro:page-load', init);
})();
      `}
    </script>
  )
}

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--color-surface-alt) 0%, var(--color-surface) 100%);
    padding: 3.5rem 0;
  }

  .page-hero__subtitle {
    text-align: center;
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  .page-hero--image {
    --page-hero-scale: 1;
    background-size: cover;
    background-position: center;
    min-height: calc(16rem * var(--page-hero-scale));
    padding-block: calc(3.5rem * var(--page-hero-scale));
    display: flex;
    align-items: center;
    position: relative;
  }

  .page-hero--image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .page-hero--image.page-hero--parallax::before {
    display: none;
  }

  .page-hero--image .page-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .page-hero__title-image {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .page-hero--image .page-hero__subtitle {
    color: #fff;
  }

  /* Parallax image hero */
  .page-hero--parallax {
    position: relative;
    overflow: hidden;
    min-height: clamp(18rem, 44vw, 26rem);
    padding: clamp(3.5rem, 10vw, 5rem) 0;
    display: block;
    background: #fff;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .page-hero__media-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .page-hero__parallax {
    position: absolute;
    left: 0;
    right: 0;
    top: -28%;
    height: 160%;
    will-change: transform;
  }

  .page-hero__parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    transform: translateY(15%);
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(15 20 25 / 0.5) 0%, rgb(15 20 25 / 0.35) 55%, rgb(15 20 25 / 0.55) 100%),
      var(--gradient-brand);
    opacity: 0.75;
  }

  .page-hero--parallax .page-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__parallax img {
      transform: none;
    }
  }
</style>
