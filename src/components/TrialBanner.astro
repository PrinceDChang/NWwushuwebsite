---
import { trialBanner } from '../data/site';
---

<div class="trial-banner">
  <a href={trialBanner.href} class="trial-banner__link">
    <span>{trialBanner.text}</span>
    <span class="trial-banner__arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .trial-banner {
    background: var(--gradient-brand);
    color: #fff;
    text-align: center;
    min-height: var(--banner-height);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trial-banner__link {
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    padding: 0.5rem 1.25rem;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    border-radius: var(--radius-pill);
    transition:
      background 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .trial-banner__link:hover {
    background: rgb(255 255 255 / 0.12);
    transform: translateY(-1px);
  }

  .trial-banner__arrow {
    transition: transform 0.25s var(--ease-out);
  }

  .trial-banner__link:hover .trial-banner__arrow {
    transform: translateX(3px);
  }
</style>
