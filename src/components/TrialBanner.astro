---
import { trialBanner } from '../data/site';
---

<div class="trial-banner">
  <a href={trialBanner.href} class="trial-banner__link">
    <span>{trialBanner.text}</span>
    <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .trial-banner {
    background: var(--color-brand);
    color: #fff;
    text-align: center;
    min-height: var(--banner-height);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trial-banner__link {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.5rem 1rem;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .trial-banner__link:hover {
    text-decoration: underline;
  }
</style>
