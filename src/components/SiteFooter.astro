---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <h2 class="site-footer__heading">Quick Links</h2>
      <ul class="site-footer__list">
        <li><a href="/policy/">School Policy</a></li>
        <li><a href="/waivers/">Waivers</a></li>
        <li><a href="/contact/">Contact Us</a></li>
        <li><a href="/trial/">Free Trial Sign Up</a></li>
      </ul>
    </div>
    <div>
      <h2 class="site-footer__heading">Location</h2>
      <p>
        {site.address.name}<br />
        {site.address.street}<br />
        {site.address.city}, {site.address.state} {site.address.zip}
      </p>
    </div>
    <div>
      <h2 class="site-footer__heading">Email</h2>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <ul class="site-footer__social" aria-label="Social media">
        <li>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        </li>
        <li>
          <a href={site.discord} target="_blank" rel="noopener noreferrer"> Discord </a>
        </li>
        <li>
          <a href={site.youtube} target="_blank" rel="noopener noreferrer"> YouTube </a>
        </li>
      </ul>
    </div>
  </div>
  <p class="site-footer__copy container">
    © {new Date().getFullYear()} {site.name}. All rights reserved.
  </p>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: #fff;
    padding: 3rem 0 1.5rem;
    margin-top: auto;
  }

  .site-footer a {
    color: #fff;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .site-footer__heading {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__list li + li {
    margin-top: 0.35rem;
  }

  .site-footer__social {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer__copy {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: #9ca3af;
    text-align: center;
  }
</style>
