---
import { site, trialBanner } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/schedule/', label: 'Schedule' },
  { href: '/location/', label: 'Location' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  return currentPath.startsWith(href.replace(/\/$/, '')) || currentPath === href;
}
---

<header class="site-header" data-site-header>
  <div class="site-header__glass" aria-hidden="true"></div>
  <div class="site-header__shape" aria-hidden="true">
    <svg class="site-header__shape-svg" viewBox="0 0 1200 112" preserveAspectRatio="none">
      <path
        class="site-header__shape-fill"
        d="M 0 0 H 1200 V 20 Q 1200 58 1184 58 H 654 A 54 54 0 0 1 546 58 H 16 Q 0 58 0 20 V 0 Z"
      />
      <path
        class="site-header__shape-line"
        d="M 16 58 H 546 A 54 54 0 0 1 654 58 H 1184"
      />
    </svg>
  </div>

  <div class="container site-header__inner">
    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {
        nav.slice(0, 2).map((item) => (
          <a
            href={item.href}
            class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/" class="site-header__logo" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt="" width="88" height="88" />
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
        {
          nav.slice(2).map((item) => (
            <a
              href={item.href}
              class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={trialBanner.href}
        class="site-header__trial btn btn--primary btn--small"
        title={trialBanner.text}
      >
        {trialBanner.buttonText}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  {`
(() => {
  const init = () => {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;

    const threshold = 24;
    let ticking = false;

    const update = () => {
      ticking = false;
      header.classList.toggle('site-header--scrolled', window.scrollY > threshold);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  };

  init();
  document.addEventListener('astro:page-load', init);
})();
  `}
</script>

<style>
  .site-header {
    --header-logo-size: clamp(4.25rem, 11vw, 5.5rem);
    --header-logo-gap: 0.5rem;
    --header-logo-outer: calc(var(--header-logo-size) + 2 * var(--header-logo-gap));
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
    overflow: visible;
    padding-bottom: calc(var(--header-logo-outer) / 2 + 0.35rem);
    background: transparent;
    transition: box-shadow 0.35s var(--ease-out);
  }

  .site-header__glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.5) 0%,
      rgb(255 255 255 / 0.32) 100%
    );
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 8px 28px rgb(15 20 25 / 0.05);
    transition:
      opacity 0.4s var(--ease-out),
      backdrop-filter 0.4s var(--ease-out);
  }

  .site-header--scrolled .site-header__glass {
    opacity: 1;
  }

  .site-header__shape {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 7.25rem;
    pointer-events: none;
    z-index: 0;
    filter: drop-shadow(0 4px 16px rgb(15 20 25 / 0.08));
    transition: filter 0.4s var(--ease-out);
  }

  .site-header--scrolled .site-header__shape {
    filter: drop-shadow(0 6px 20px rgb(15 20 25 / 0.1));
  }

  .site-header__shape-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-header__shape-fill {
    fill: #fff;
    transition: fill 0.4s var(--ease-out);
  }

  .site-header--scrolled .site-header__shape-fill {
    fill: rgb(255 255 255 / 0.18);
  }

  .site-header__shape-line {
    fill: none;
    stroke: var(--color-border-subtle);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding-block: 0.625rem 0;
    background: transparent;
  }

  .site-header__nav {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-header__nav--left {
    justify-content: flex-end;
    padding-right: 0.5rem;
  }

  .site-header__nav--right {
    justify-content: flex-start;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    justify-content: flex-start;
    padding-left: 0.5rem;
    min-width: 0;
  }

  .site-header__trial {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.8125rem;
    padding: 0.4375rem 0.875rem;
    letter-spacing: 0.01em;
  }

  .site-header__trial:hover,
  .site-header__trial:focus-visible {
    color: #fff;
  }

  .site-header__link {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    padding: 0.4375rem 1rem;
    border-radius: var(--radius-pill);
    background: transparent;
    transition:
      color 0.25s var(--ease-out),
      background 0.25s var(--ease-out),
      -webkit-text-fill-color 0.25s var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    color: var(--color-brand-dark);
    background: var(--gradient-brand-soft);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .site-header__link:hover,
    .site-header__link:focus-visible {
      color: transparent;
      background:
        var(--gradient-brand-soft) padding-box,
        var(--gradient-brand) border-box;
      -webkit-background-clip: padding-box, text;
      background-clip: padding-box, text;
      -webkit-text-fill-color: transparent;
    }

    .site-header--scrolled .site-header__link:hover,
    .site-header--scrolled .site-header__link:focus-visible {
      background:
        rgb(255 255 255 / 0.38) padding-box,
        var(--gradient-brand) border-box;
    }
  }

  .site-header__link--active {
    color: var(--color-brand-dark);
    background: var(--gradient-brand-soft);
    text-decoration: none;
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .site-header__link--active {
      color: transparent;
      background:
        var(--gradient-brand-soft) padding-box,
        var(--gradient-brand) border-box;
      -webkit-background-clip: padding-box, text;
      background-clip: padding-box, text;
      -webkit-text-fill-color: transparent;
    }

    .site-header--scrolled .site-header__link--active {
      background:
        rgb(255 255 255 / 0.42) padding-box,
        var(--gradient-brand) border-box;
    }
  }

  .site-header__logo {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--header-logo-outer);
    height: var(--header-logo-outer);
    padding: var(--header-logo-gap);
    line-height: 0;
    align-self: center;
    margin-bottom: calc(-1 * (var(--header-logo-outer) / 2 - 0.125rem));
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
    transition: transform 0.35s var(--ease-spring);
  }

  .site-header__logo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 4px 18px rgb(15 20 25 / 0.12);
    transition:
      background 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .site-header--scrolled .site-header__logo::before {
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.65),
      0 6px 20px rgb(15 20 25 / 0.1);
  }

  .site-header__logo img {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--header-logo-size);
    height: var(--header-logo-size);
    border-radius: 50%;
    transition: transform 0.35s var(--ease-spring);
    transform-origin: center;
  }

  .site-header__logo:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .site-header__logo:hover img,
  .site-header__logo:focus-visible img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__glass,
    .site-header__shape,
    .site-header__shape-fill,
    .site-header__logo::before {
      transition: none;
    }

    .site-header__logo,
    .site-header__logo img {
      transition: none;
    }

    .site-header__logo:hover,
    .site-header__logo:hover img,
    .site-header__logo:focus-visible img {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding-bottom: 0;
      background: rgb(255 255 255 / 0.72);
      backdrop-filter: blur(14px) saturate(1.2);
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
      border-bottom: 1px solid var(--color-border-subtle);
      box-shadow: 0 4px 16px rgb(15 20 25 / 0.06);
    }

    .site-header__glass {
      display: none;
    }

    .site-header--scrolled {
      background: rgb(255 255 255 / 0.78);
      backdrop-filter: blur(20px) saturate(1.35);
      -webkit-backdrop-filter: blur(20px) saturate(1.35);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 6px 20px rgb(15 20 25 / 0.06);
    }

    .site-header__shape {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      min-height: var(--header-height);
      padding-block: 0.625rem;
    }

    .site-header__logo {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      align-self: center;
      width: auto;
      height: auto;
      margin-bottom: 0;
      padding: 0;
      background: #fff;
      box-shadow: var(--shadow-sm);
    }

    .site-header__logo img {
      width: clamp(3.25rem, 18vw, 4rem);
      height: clamp(3.25rem, 18vw, 4rem);
    }

    .site-header__nav--left {
      grid-column: 1;
      grid-row: 2;
      justify-content: center;
      padding-right: 0;
    }

    .site-header__right {
      grid-column: 2;
      grid-row: 2;
      justify-content: center;
      padding-left: 0;
    }

    .site-header__nav--right {
      justify-content: center;
    }

    .site-header__trial {
      display: none;
    }

    .site-header__link {
      padding: 0.4375rem 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
