---
import { site, trialBanner } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/schedule/', label: 'Schedule' },
  { href: '/location/', label: 'Location' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  return currentPath.startsWith(href.replace(/\/$/, '')) || currentPath === href;
}
---

<header class="site-header" data-site-header>
  <div class="site-header__shape" aria-hidden="true">
    <div class="site-header__ambient"></div>
    <div class="site-header__shape-line"></div>
  </div>

  <div class="container site-header__inner">
    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {
        nav.slice(0, 2).map((item) => (
          <a
            href={item.href}
            class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/" class="site-header__logo" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt="" width="44" height="44" />
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
        {
          nav.slice(2).map((item) => (
            <a
              href={item.href}
              class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={trialBanner.href}
        class="site-header__trial btn btn--primary btn--small"
        title={trialBanner.text}
      >
        {trialBanner.buttonText}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  {`
(() => {
  const init = () => {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;

    const threshold = 24;
    let ticking = false;

    const update = () => {
      ticking = false;
      header.classList.toggle('site-header--scrolled', window.scrollY > threshold);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  };

  init();
  document.addEventListener('astro:page-load', init);
})();
  `}
</script>

<style>
  .site-header {
    --header-logo-size: 2.75rem;
    --header-logo-gap: 0;
    --header-logo-outer: var(--header-logo-size);
    --header-bar-height: calc(58 / 112 * 7.25rem);
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
    overflow: visible;
    width: 100%;
    max-width: none;
    padding-bottom: 0;
    background: transparent;
    transition:
      box-shadow 0.35s var(--ease-out),
      filter 0.35s var(--ease-out);
  }

  .site-header--scrolled {
    box-shadow: none;
  }

  /* Full viewport bleed — avoids Safari SVG mask + percentage width gaps */
  .site-header__shape {
    position: absolute;
    top: 0;
    left: 50%;
    right: auto;
    width: 100vw;
    max-width: none;
    height: 7.25rem;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
    transition: filter 0.4s var(--ease-out);
  }

  @supports (width: 100dvw) {
    .site-header__shape {
      width: 100dvw;
    }
  }

  .site-header__ambient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-bar-height);
    z-index: 0;
    pointer-events: none;
    background: var(--site-ambient-bg);
    background-size: 100vw 100vh;
    background-position: center top;
    opacity: 0.52;
  }

  @supports (width: 100dvw) {
    .site-header__ambient {
      background-size: 100dvw 100dvh;
    }
  }

  .site-header__shape-line {
    position: absolute;
    top: var(--header-bar-height);
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: rgb(229 154 77 / 0.22);
    transition: background 0.4s var(--ease-out);
  }

  .site-header--scrolled .site-header__shape-line {
    background: rgb(208 74 69 / 0.28);
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding-block: 0.375rem;
    background: transparent;
  }

  .site-header__nav {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-header__nav--left {
    justify-content: flex-end;
    padding-right: 0.5rem;
  }

  .site-header__nav--right {
    justify-content: flex-start;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    justify-content: flex-start;
    padding-left: 0.5rem;
    min-width: 0;
  }

  .site-header__trial {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.8125rem;
    padding: 0.4375rem 0.875rem;
    letter-spacing: 0.01em;
  }

  .site-header__trial:hover,
  .site-header__trial:focus-visible {
    color: #fff;
  }

  .site-header__link {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    padding: 0.4375rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: transparent;
    transition:
      color 0.25s var(--ease-out),
      background 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      -webkit-text-fill-color 0.25s var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    color: var(--color-brand-dark);
    background: rgb(255 248 244 / 0.82);
    border-color: rgb(229 154 77 / 0.22);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .site-header__link:hover,
    .site-header__link:focus-visible {
      color: transparent;
      background:
        var(--gradient-brand-soft) padding-box,
        var(--gradient-brand) border-box;
      -webkit-background-clip: padding-box, text;
      background-clip: padding-box, text;
      -webkit-text-fill-color: transparent;
    }

    .site-header--scrolled .site-header__link:hover,
    .site-header--scrolled .site-header__link:focus-visible {
      background:
        rgb(255 252 250 / 0.92) padding-box,
        var(--gradient-brand) border-box;
    }
  }

  .site-header__link--active {
    color: var(--color-brand-dark);
    background: rgb(255 247 242 / 0.88);
    border-color: rgb(229 154 77 / 0.28);
    text-decoration: none;
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .site-header__link--active {
      color: transparent;
      background:
        var(--gradient-brand-soft) padding-box,
        var(--gradient-brand) border-box;
      -webkit-background-clip: padding-box, text;
      background-clip: padding-box, text;
      -webkit-text-fill-color: transparent;
    }

    .site-header--scrolled .site-header__link--active {
      background:
        rgb(255 252 250 / 0.94) padding-box,
        var(--gradient-brand) border-box;
    }
  }

  .site-header__logo {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--header-logo-size);
    height: var(--header-logo-size);
    padding: 0;
    line-height: 0;
    align-self: center;
    margin-bottom: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
    transition: transform 0.35s var(--ease-spring);
  }

  .site-header__logo img {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--header-logo-size);
    height: var(--header-logo-size);
    border-radius: 50%;
    transition: transform 0.35s var(--ease-spring);
    transform-origin: center;
  }

  .site-header__logo:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .site-header__logo:hover img,
  .site-header__logo:focus-visible img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__shape {
      transition: none;
    }

    .site-header__logo,
    .site-header__logo img {
      transition: none;
    }

    .site-header__logo:hover,
    .site-header__logo:hover img,
    .site-header__logo:focus-visible img {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding-bottom: 0;
      background: transparent;
    }

    .site-header--scrolled {
      box-shadow: none;
    }

    .site-header__shape {
      display: block;
      top: auto;
      bottom: 0;
      height: 2.75rem;
      --header-bar-height: 100%;
    }

    .site-header__ambient {
      height: 100%;
      background-size: 100% 100%;
    }

    .site-header__shape-line {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      min-height: var(--header-height);
      padding-block: 0.625rem;
    }

    .site-header__logo {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      align-self: center;
      width: auto;
      height: auto;
      margin-bottom: 0;
      padding: 0;
      background: transparent;
      box-shadow: none;
    }

    .site-header__logo img {
      width: clamp(3.25rem, 18vw, 4rem);
      height: clamp(3.25rem, 18vw, 4rem);
    }

    .site-header__nav--left {
      grid-column: 1;
      grid-row: 2;
      justify-content: center;
      padding-right: 0;
    }

    .site-header__right {
      grid-column: 2;
      grid-row: 2;
      justify-content: center;
      padding-left: 0;
    }

    .site-header__nav--right {
      justify-content: center;
    }

    .site-header__trial {
      display: none;
    }

    .site-header__link {
      padding: 0.4375rem 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
