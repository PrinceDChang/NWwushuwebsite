---
import { site } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/schedule/', label: 'Schedule' },
  { href: '/location/', label: 'Location' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  return currentPath.startsWith(href.replace(/\/$/, '')) || currentPath === href;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {nav.slice(0, 2).map((item) => (
        <a
          href={item.href}
          class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/" class="site-header__logo" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt="" width="88" height="88" />
    </a>

    <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
      {nav.slice(2).map((item) => (
        <a
          href={item.href}
          class:list={['site-header__link', isActive(item.href) && 'site-header__link--active']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--header-height);
    padding-block: 0.5rem;
  }

  .site-header__nav {
    display: flex;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }

  .site-header__nav--left {
    justify-content: flex-end;
  }

  .site-header__nav--right {
    justify-content: flex-start;
  }

  .site-header__link {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
  }

  .site-header__link:hover {
    color: var(--color-brand);
  }

  .site-header__link--active {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .site-header__logo img {
    width: clamp(4rem, 12vw, 5.5rem);
    height: auto;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .site-header__logo {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
    }

    .site-header__nav--left {
      grid-column: 1;
      grid-row: 2;
      justify-content: center;
    }

    .site-header__nav--right {
      grid-column: 2;
      grid-row: 2;
      justify-content: center;
    }
  }
</style>
