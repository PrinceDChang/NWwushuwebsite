---
import type { WushuClass } from '../data/classes';

interface Props {
  classInfo: WushuClass;
}

const { classInfo } = Astro.props;
---

<article class="card class-card">
  <div class="class-card__meta">
    <h2 class="class-card__title">{classInfo.title}</h2>
    <p class="text-muted"><strong>{classInfo.ages}</strong></p>
    <p>{classInfo.description}</p>
    <p class="class-card__price">{classInfo.priceNote}</p>
  </div>
  <div class="class-card__schedule">
    <p>
      <strong>{classInfo.day}</strong><br />
      {classInfo.time}
    </p>
    <a href={classInfo.signupHref} class="btn btn--primary btn--small"> Sign Up </a>
  </div>
</article>

<style>
  .class-card__title {
    margin-bottom: 0.35rem;
    font-size: 1.375rem;
  }

  .class-card + .class-card {
    margin-top: 1.25rem;
  }
</style>
