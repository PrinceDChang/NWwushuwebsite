<section class="cta-band" aria-labelledby="cta-heading">
  <div class="container text-center">
    <h2 id="cta-heading" class="cta-band__title">Ready to Begin Your Journey?</h2>
    <p class="cta-band__text">Your first class is free. Come experience the art of Wushu.</p>
    <div class="cta-band__actions">
      <a href="/trial/" class="btn btn--secondary">Try your first class for free</a>
      <a href="/contact/" class="btn btn--ghost cta-band__ghost">Ask a question</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--gradient-brand);
    color: #fff;
    padding: 3.5rem 0;
  }

  .cta-band__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: 0.75rem;
  }

  .cta-band__text {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    opacity: 0.95;
  }

  .cta-band__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Ensure contrast on the gradient background */
  .cta-band__ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.55);
  }

  .cta-band__ghost:hover {
    border-color: rgb(255 255 255 / 0.75);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
</style>
