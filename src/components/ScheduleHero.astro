---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;

const days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'] as const;

const timeSlots = [
  '8 – 9 AM',
  '9 – 10 AM',
  '10 – 11 AM',
  '11 – 12 PM',
  '12 – 1 PM',
  '1 – 2 PM',
  '2 – 3 PM',
] as const;
---

<section class="page-hero page-hero--schedule-calendar" aria-label={title}>
  <div class="schedule-calendar" aria-hidden="true">
    <table class="schedule-calendar__table">
      <thead>
        <tr>
          <th class="schedule-calendar__corner" scope="col"></th>
          {
            days.map((day) => (
              <th
                scope="col"
                class:list={['schedule-calendar__day', `schedule-calendar__day--${day.toLowerCase()}`]}
              >
                {day}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          timeSlots.map((slot) => (
            <tr>
              <th scope="row" class="schedule-calendar__time">{slot}</th>
              {
                days.map((day) => {
                  if (day === 'SAT' && slot === '12 – 1 PM') return null;

                  if (day === 'SAT' && slot === '10 – 11 AM') {
                    return (
                      <td class="schedule-calendar__cell schedule-calendar__cell--sat schedule-calendar__cell--event">
                        <span class="schedule-calendar__event schedule-calendar__event--kids">
                          Kids Class
                        </span>
                      </td>
                    );
                  }

                  if (day === 'SAT' && slot === '11 – 12 PM') {
                    return (
                      <td
                        class="schedule-calendar__cell schedule-calendar__cell--sat schedule-calendar__cell--event"
                        rowspan={2}
                      >
                        <span class="schedule-calendar__event schedule-calendar__event--adult">
                          Adult Class
                        </span>
                      </td>
                    );
                  }

                  return (
                    <td
                      class:list={[
                        'schedule-calendar__cell',
                        `schedule-calendar__cell--${day.toLowerCase()}`,
                      ]}
                    />
                  );
                })
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="schedule-calendar__note">*more lessons may be added in the future</p>

  <div class="container page-hero__content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero--schedule-calendar {
    position: relative;
    overflow: visible;
    padding: 2.5rem 0.75rem 2.25rem;
    min-height: 20rem;
    background: #f4f6f8;
  }

  .schedule-calendar {
    position: absolute;
    inset: 0.5rem 0.75rem 2.25rem;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .schedule-calendar__note {
    position: absolute;
    z-index: 1;
    right: 0.75rem;
    bottom: 0.5rem;
    left: 0.75rem;
    margin: 0;
    max-width: 76rem;
    margin-inline: auto;
    padding: 0 0.15rem;
    font-size: clamp(0.6875rem, 1.25vw, 0.8125rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-ink);
    text-align: right;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.9);
  }

  .schedule-calendar__table {
    width: 100%;
    height: 100%;
    min-height: 15.5rem;
    max-width: 76rem;
    margin-inline: auto;
    border-collapse: collapse;
    table-layout: fixed;
    border: 2.5px solid #121212;
    background: #fff;
    box-shadow: 0 8px 28px rgb(15 20 25 / 0.12);
    font-size: clamp(0.625rem, 1.35vw, 0.8125rem);
    line-height: 1.2;
  }

  .schedule-calendar__corner {
    width: 6.25rem;
    background: #121212;
    border-right: 2.5px solid #121212;
    border-bottom: 1px solid #121212;
  }

  .schedule-calendar__day {
    padding: 0.5rem 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95em;
    letter-spacing: 0.05em;
    text-align: center;
    border-right: 1px solid rgb(18 18 18 / 0.12);
    border-bottom: 2px solid #121212;
  }

  .schedule-calendar__day--sun {
    background: #f5c99a;
    color: #4a2f12;
  }

  .schedule-calendar__day--mon {
    background: #d4dae3;
    color: #2a3340;
  }

  .schedule-calendar__day--tue {
    background: #ffe98a;
    color: #4a3d08;
  }

  .schedule-calendar__day--wed {
    background: #f9a3c8;
    color: #5a1230;
  }

  .schedule-calendar__day--thu {
    background: #f28b7a;
    color: #5a1810;
  }

  .schedule-calendar__day--fri {
    background: #8ed4a8;
    color: #143a24;
  }

  .schedule-calendar__day--sat {
    background: var(--color-brand-mid);
    color: #fff;
    border-right: none;
  }

  .schedule-calendar__time {
    width: 6.25rem;
    padding: 0.35rem 0.4rem;
    background: #fff;
    color: #121212;
    font-weight: 700;
    text-align: center;
    vertical-align: middle;
    border-right: 2.5px solid #121212;
    border-bottom: 1px dashed rgb(18 18 18 / 0.55);
  }

  .schedule-calendar__cell {
    padding: 0;
    height: 2rem;
    background: #fff;
    vertical-align: middle;
    border-right: 1px solid #121212;
    border-bottom: 1px dashed rgb(18 18 18 / 0.55);
  }

  .schedule-calendar__cell--sun {
    background: rgb(245 201 154 / 0.28);
  }

  .schedule-calendar__cell--mon {
    background: rgb(212 218 227 / 0.45);
  }

  .schedule-calendar__cell--tue {
    background: rgb(255 233 138 / 0.3);
  }

  .schedule-calendar__cell--wed {
    background: rgb(249 163 200 / 0.28);
  }

  .schedule-calendar__cell--thu {
    background: rgb(242 139 122 / 0.28);
  }

  .schedule-calendar__cell--fri {
    background: rgb(142 212 168 / 0.3);
  }

  .schedule-calendar__cell--sat {
    background: rgb(var(--color-brand-rgb) / 0.12);
    border-right: none;
  }

  .schedule-calendar__cell--sat.schedule-calendar__cell--event {
    background: rgb(255 241 245 / 0.5);
  }

  .schedule-calendar__event {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(100% - 4px);
    height: calc(100% - 4px);
    min-height: 1.75rem;
    margin: 2px;
    border-radius: 3px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05em;
    text-align: center;
    border: 1.5px solid rgb(18 18 18 / 0.2);
    box-shadow: 0 2px 6px rgb(15 20 25 / 0.12);
  }

  .schedule-calendar__event--kids {
    background: #f4a9c4;
    color: #3d1024;
  }

  .schedule-calendar__event--adult {
    background: var(--color-brand-mid);
    color: #fff;
    border-color: rgb(90 20 40 / 0.35);
    min-height: 3.5rem;
  }

  .page-hero--schedule-calendar .page-hero__content {
    position: relative;
    z-index: 2;
    max-width: 40rem;
    margin-inline: auto;
    padding: 0.75rem 1.25rem 1rem;
    background: transparent;
  }

  .page-hero--schedule-calendar .hero-title {
    color: transparent;
    text-shadow: none;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-hero--schedule-calendar .page-hero__subtitle {
    text-align: center;
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.8);
  }

  @media (max-width: 640px) {
    .page-hero--schedule-calendar {
      min-height: 16rem;
    }

    .schedule-calendar {
      inset: 0.35rem 0.25rem;
    }

    .schedule-calendar__table {
      font-size: 0.52rem;
      min-height: 13rem;
    }

    .schedule-calendar__corner,
    .schedule-calendar__time {
      width: 3.75rem;
    }

    .schedule-calendar__event {
      font-size: 0.55rem;
      min-height: 1.25rem;
    }

    .schedule-calendar__event--adult {
      min-height: 2.5rem;
    }

    .page-hero--schedule-calendar .page-hero__content {
      padding: 0.5rem 0.75rem 0.75rem;
    }
  }
</style>
