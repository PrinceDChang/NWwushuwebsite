---
import { site } from '../data/site';
import { fetchInstagramFeed } from '../lib/instagram';
import InstagramFeed from './InstagramFeed.astro';
import InstagramProfileHeader from './InstagramProfileHeader.astro';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const username = site.instagramHandle.replace(/^@/, '');

let profile = null;
let posts: Awaited<ReturnType<typeof fetchInstagramFeed>>['posts'] = [];
let fetchError: string | null = null;

try {
  const data = await fetchInstagramFeed(username, limit);
  profile = data.profile;
  posts = data.posts;
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'Could not load Instagram';
}
---

<InstagramProfileHeader profile={profile} />
<InstagramFeed posts={posts} fetchError={fetchError} />
