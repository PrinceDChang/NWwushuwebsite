---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyTrialCTA from '../components/StickyTrialCTA.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  showStickyCta?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname,
  showStickyCta = true,
  bodyClass = '',
} = Astro.props;

const pageTitle = title === site.shortName ? title : `${title} | ${site.shortName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[showStickyCta && 'has-sticky-cta', bodyClass]}>
    <script is:inline>
      window.NW_BASE = (function () {
        var match = location.pathname.match(/^(.*\/NWwushuwebsite\/)/);
        return match ? match[1] : '/';
      })();
    </script>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {showStickyCta && <StickyTrialCTA />}
    <slot name="scripts" />
  </body>
</html>
