---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrialStepper from '../../components/TrialStepper.astro';
import { waiverText, photoReleaseText } from '../../data/waivers';
---

<BaseLayout title="Free Trial — Waivers" currentPath="/trial">
  <PageHero title="Free Trial Sign Up" variant="image" imageSrc="/images/studio-training.jpg" />

  <div class="container container--narrow">
    <TrialStepper current={2} />

    <form id="trial-agreements-form" class="form-grid">
      <h2 class="section__title">Waiver</h2>
      <div class="legal-scroll" tabindex="0" role="region" aria-label="Waiver text">
        {waiverText.split('\n').map((line) => (
          <p style="margin: 0 0 0.5rem">{line}</p>
        ))}
      </div>
      <label>
        <input type="checkbox" name="waiverAccepted" required />
        I understand and have read and agree to the waiver
      </label>

      <h2 class="section__title">Photo release</h2>
      <div class="legal-scroll" tabindex="0" role="region" aria-label="Photo release text">
        {photoReleaseText.split('\n').map((line) => (
          <p style="margin: 0 0 0.5rem">{line}</p>
        ))}
      </div>
      <fieldset class="form-field">
        <legend class="required">Photo release choice</legend>
        <label style="display: block; margin-bottom: 0.5rem">
          <input type="radio" name="photoRelease" value="agree" required />
          I agree to the photo release
        </label>
        <label style="display: block">
          <input type="radio" name="photoRelease" value="decline" />
          I do not consent to the photo release
        </label>
      </fieldset>

      <div class="form-actions">
        <button type="button" class="btn btn--outline" id="back-btn">← Back</button>
        <button type="submit" class="btn btn--primary">Next →</button>
      </div>
    </form>
  </div>
</BaseLayout>

<script type="module" src="/scripts/trial-agreements.js"></script>
