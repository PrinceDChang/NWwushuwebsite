---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrialStepper from '../../components/TrialStepper.astro';
import { site } from '../../data/site';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_TRIAL_ID || 'your_trial_form_id';
---

<BaseLayout title="Free Trial — Schedule" currentPath="/trial">
  <PageHero title="Free Trial Sign Up" variant="image" imageSrc="/images/studio-training.jpg" />

  <div class="container">
    <TrialStepper current={3} />

    <form id="trial-booking-form" class="trial-booking" data-formspree-id={formspreeId}>
      <div class="trial-booking__col">
        <p class="trial-booking__step-label"><span>1</span> Confirm lesson</p>
        <h2 class="section__title">Trial lesson</h2>
        <p>1 session · Free first wushu class</p>
        <fieldset class="form-field">
          <legend class="required">Class type</legend>
          <label style="display: block; margin-bottom: 0.5rem">
            <input type="radio" name="classType" value="kids" checked />
            Child (Kids Wushu · 10:00–11:00 AM)
          </label>
          <label style="display: block">
            <input type="radio" name="classType" value="adult" />
            Teen &amp; Adult (11:00 AM–1:00 PM)
          </label>
        </fieldset>
      </div>

      <div class="trial-booking__col">
        <p class="trial-booking__step-label"><span>2</span> Select a Saturday</p>
        <h2 class="section__title">Calendar</h2>
        <div class="calendar">
          <div class="calendar__header">
            <button type="button" class="btn btn--ghost btn--small" id="cal-prev" aria-label="Previous month">←</button>
            <strong id="cal-month"></strong>
            <button type="button" class="btn btn--ghost btn--small" id="cal-next" aria-label="Next month">→</button>
          </div>
          <div class="calendar__grid" id="cal-grid"></div>
        </div>
      </div>

      <div class="trial-booking__col">
        <p class="trial-booking__step-label"><span>3</span> Time slot</p>
        <h2 class="section__title">Selected date</h2>
        <p id="selected-date-label" class="text-muted">Choose a Saturday</p>
        <button type="button" class="time-slot" id="time-slot" aria-pressed="true">10:00 AM – 11:00 AM</button>
        <p class="text-muted" style="font-size: 0.875rem; margin-top: 1rem">
          We will confirm your spot within {site.replyTime}. Max {site.maxClassSize} students per class.
        </p>
        <div class="form-actions" style="margin-top: 1.5rem">
          <button type="button" class="btn btn--outline" id="back-btn">← Back</button>
          <button type="button" class="btn btn--primary" id="submit-trial">Submit request</button>
        </div>
      </div>
    </form>
  </div>
</BaseLayout>

<style>
  .trial-booking {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 960px) {
    .trial-booking {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .trial-booking__col {
    background: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .trial-booking__step-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-brand);
    margin: 0 0 1rem;
  }

  .trial-booking__step-label span {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }
</style>

<script type="module" src="/scripts/trial-booking.js"></script>
