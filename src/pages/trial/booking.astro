---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrialStepper from '../../components/TrialStepper.astro';
import { site } from '../../data/site';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_TRIAL_ID || 'your_trial_form_id';
---

<BaseLayout title="Free Trial — Schedule" currentPath="/trial">
  <PageHero title="Free Trial Sign Up" variant="image" imageSrc="/images/studio-training.jpg" />

  <div class="container">
    <TrialStepper current={3} />

    <form
      id="trial-booking-form"
      class="trial-booking"
      data-formspree-id={formspreeId}
      data-class-capacity={site.maxClassSize}
      data-reply-time={site.replyTime}
    >
      <div class="trial-booking__columns">
      <div class="trial-booking__col">
        <p class="trial-booking__step-label"><span>1</span> Confirm lesson</p>
        <h2 class="section__title">Trial lesson</h2>
        <p>1 session · Free first wushu class</p>
        <fieldset class="form-field">
          <legend class="required">Class type</legend>
          <label>
            <input type="radio" name="classType" value="kids" checked />
            Child (Kids Wushu · 10:00–11:00 AM)
          </label>
          <label>
            <input type="radio" name="classType" value="adult" />
            Teen &amp; Adult (11:00 AM–1:00 PM)
          </label>
        </fieldset>
      </div>

      <div class="trial-booking__col trial-booking__col--date">
        <p class="trial-booking__step-label"><span>2</span> Select the date</p>
        <div class="calendar" role="group" aria-label="Choose a trial date">
          <div class="calendar__header">
            <button type="button" class="btn btn--ghost btn--small" id="cal-prev" aria-label="Previous month">←</button>
            <strong id="cal-month" aria-live="polite"></strong>
            <button type="button" class="btn btn--ghost btn--small" id="cal-next" aria-label="Next month">→</button>
          </div>
          <div class="calendar__grid" id="cal-grid"></div>
          <p class="calendar__hint">Trial classes meet on Saturdays. Pick an available Saturday.</p>
        </div>
        <input type="hidden" name="selectedDate" id="selected-date-input" value="" />
      </div>

      <div class="trial-booking__col trial-booking__col--locked" id="trial-step-3" aria-disabled="true">
        <p class="trial-booking__step-label"><span>3</span> Time slot</p>
        <h2 class="section__title">Selected date</h2>
        <p id="selected-date-label" class="text-muted">Select a date above to continue</p>
        <button type="button" class="time-slot" id="time-slot" disabled aria-pressed="false">
          <span class="time-slot__time" id="time-slot-time">10:00 AM – 11:00 AM</span>
          <span class="time-slot__spots" id="time-slot-spots">Select a date to see remaining spots</span>
        </button>
        <p class="text-muted trial-booking__note" id="trial-spots-note">
          We will confirm your spot within {site.replyTime}. Max {site.maxClassSize} students per class.
        </p>
      </div>
      </div>

      <div class="form-actions form-actions--end trial-booking__actions">
        <button type="button" class="btn btn--outline" id="back-btn">← Back</button>
        <button type="button" class="btn btn--primary" id="submit-trial" disabled>Submit request</button>
      </div>
    </form>
  </div>
</BaseLayout>

<style>
  .trial-booking {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: min(72vh, calc(100dvh - 16rem));
    margin-bottom: 3rem;
  }

  .trial-booking__columns {
    display: grid;
    gap: 1.25rem;
    flex: 1;
    align-content: start;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .trial-booking__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }
  }

  .trial-booking__note {
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .trial-booking__actions {
    margin-top: auto;
    padding-top: 2.5rem;
  }

  .trial-booking__col {
    background: var(--color-surface-elevated);
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(10px);
  }

  .trial-booking__step-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-brand-mid);
    margin: 0 0 1rem;
  }

  .trial-booking__step-label span {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }

  .trial-booking__col--locked {
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  .trial-booking__col--locked .trial-booking__step-label {
    color: var(--color-muted);
  }

  .trial-booking__col--locked .trial-booking__step-label span {
    background: var(--color-muted);
  }
</style>

<script type="module" src="/scripts/trial-booking.js"></script>
