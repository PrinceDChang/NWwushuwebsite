---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrialStepper from '../../components/TrialStepper.astro';
---

<BaseLayout title="Free Trial Sign Up" currentPath="/trial" bodyClass="trial-page">
  <PageHero
    title="Free Trial Sign Up"
    variant="image"
    imageSrc="/images/studio-training.jpg"
  />

  <div class="container container--narrow trial-flow">
    <TrialStepper current={1} />

    <form id="trial-step1-form" class="form-grid">
      <h2 class="section__title">Personal information</h2>
      <div class="form-field">
        <label class="required" for="fullName">Full name</label>
        <input id="fullName" name="fullName" required autocomplete="name" placeholder="Full name" />
      </div>
      <div class="form-grid form-grid--2">
        <div class="form-field">
          <label class="required" for="gender">Gender</label>
          <select id="gender" name="gender" required>
            <option value="">Select</option>
            <option value="Female">Female</option>
            <option value="Male">Male</option>
            <option value="Non-binary">Non-binary</option>
            <option value="Prefer not to say">Prefer not to say</option>
          </select>
        </div>
        <div class="form-field">
          <label class="required" for="birthday">Birthday</label>
          <input id="birthday" name="birthday" type="date" required />
        </div>
      </div>
      <div class="form-field">
        <label class="required" for="experience">Athlete experience</label>
        <select id="experience" name="experience" required>
          <option value="">Select</option>
          <option value="None">No prior martial arts</option>
          <option value="Some">Some experience</option>
          <option value="Competitive">Competitive / advanced</option>
        </select>
      </div>
      <div class="form-field">
        <label for="comment">Comment</label>
        <textarea id="comment" name="comment" placeholder="Anything we should know?"></textarea>
      </div>

      <div class="form-field">
        <label>
          <input type="checkbox" name="isMinor" id="isMinor" />
          Participant is under 18 — I am the parent or legal guardian completing this form
        </label>
      </div>

      <h2 class="section__title">Emergency contact</h2>
      <div class="form-field">
        <label class="required" for="guardianName">Full name</label>
        <input id="guardianName" name="guardianName" required autocomplete="name" placeholder="Full name" />
      </div>
      <div class="form-field">
        <label class="required" for="guardianEmail">Email</label>
        <input id="guardianEmail" name="guardianEmail" type="email" required autocomplete="email" placeholder="you@example.com" />
      </div>
      <div class="form-field">
        <label class="required" for="guardianPhone">Phone</label>
        <input id="guardianPhone" name="guardianPhone" type="tel" required autocomplete="tel" placeholder="+1 (555) 000-0000" />
      </div>
      <div class="form-field">
        <label class="required" for="guardianRelation">Relationship</label>
        <input id="guardianRelation" name="guardianRelation" required placeholder="e.g. Parent, Self" />
      </div>

      <div class="form-actions form-actions--end">
        <button type="submit" class="btn btn--primary">Next →</button>
      </div>
    </form>
  </div>
</BaseLayout>

<script type="module" src="/scripts/trial-step1.js"></script>
