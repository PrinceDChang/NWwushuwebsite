---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrialStepper from '../../components/TrialStepper.astro';
import FAQSection from '../../components/FAQSection.astro';
import ConfirmCardIcon from '../../components/ConfirmCardIcon.astro';
import { faqItems } from '../../data/faq';
---

<BaseLayout title="Trial Request Received" currentPath="/trial" showStickyCta={false}>
  <PageHero title="Free Trial Sign Up" variant="image" imageSrc="/images/studio-training.jpg" />

  <div class="container container--narrow trial-confirm">
    <TrialStepper current={3} />

    <p class="trial-confirm__lead">Your trial request is in!</p>
    <p class="trial-confirm__intro text-muted text-center">
      <span id="confirm-intro-text">We received your request</span><span id="confirm-email-part" hidden>
        and a confirmation email has been sent to <strong id="confirm-email-value"></strong></span>.
    </p>

    <div class="confirm-card">
      <ConfirmCardIcon />
      <h2 class="trial-confirm__card-title">Scheduled trial lesson</h2>
      <p class="trial-confirm__class" id="confirm-class">—</p>
      <p class="trial-confirm__date" id="confirm-date">—</p>
      <p class="trial-confirm__time" id="confirm-time">—</p>

      <p class="trial-confirm__note">
        Please wear comfortable sportswear and athletic shoes. We are excited to meet you!
      </p>
    </div>

    <section class="trial-confirm__calendar" aria-labelledby="calendar-heading">
      <h2 id="calendar-heading" class="trial-confirm__calendar-title">Add to your calendar</h2>
      <p class="trial-confirm__calendar-lead text-muted">
        Save your trial lesson to your calendar
      </p>
      <div class="trial-confirm__calendar-actions">
        <a class="btn btn--outline btn--small trial-confirm__cal-btn" id="cal-google">
          <svg class="trial-confirm__cal-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          Google Calendar
        </a>
        <button type="button" class="btn btn--outline btn--small trial-confirm__cal-btn" id="cal-apple">
          <svg class="trial-confirm__cal-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            ></path>
          </svg>
          Apple Calendar
        </button>
        <a class="btn btn--outline btn--small trial-confirm__cal-btn" id="cal-microsoft">
          <svg class="trial-confirm__cal-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect fill="#F25022" x="1" y="1" width="10" height="10" rx="0.5"></rect>
            <rect fill="#7FBA00" x="13" y="1" width="10" height="10" rx="0.5"></rect>
            <rect fill="#00A4EF" x="1" y="13" width="10" height="10" rx="0.5"></rect>
            <rect fill="#FFB900" x="13" y="13" width="10" height="10" rx="0.5"></rect>
          </svg>
          Microsoft Outlook
        </a>
      </div>
    </section>

    <p class="text-center trial-confirm__home">
      <a href="/" class="btn btn--primary">Go back to homepage</a>
    </p>
  </div>

  <FAQSection items={faqItems.slice(0, 6)} variant="dark" />
</BaseLayout>

<style>
  .trial-confirm {
    text-align: center;
    margin-bottom: 2rem;
  }

  .trial-confirm__lead {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.625rem);
    font-weight: 700;
  }

  .trial-confirm__intro {
    max-width: 34rem;
    margin: 0 auto 2rem;
    line-height: 1.65;
  }

  .trial-confirm__card-title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .trial-confirm__class {
    color: var(--color-brand-mid);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .trial-confirm__date {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }

  .trial-confirm__time {
    margin: 0 0 1rem;
    color: var(--color-muted);
  }

  .trial-confirm__note {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.9375rem;
    text-align: center;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .trial-confirm__calendar {
    max-width: 28rem;
    margin: 0 auto 2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .trial-confirm__calendar-title {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
  }

  .trial-confirm__calendar-lead {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
  }

  .trial-confirm__calendar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    justify-content: center;
  }

  .trial-confirm__cal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .trial-confirm__cal-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .trial-confirm__home {
    margin: 0;
  }
</style>

<script type="module" src="/scripts/trial-confirmation.js"></script>
