---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { waiverText, photoReleaseText } from '../data/waivers';
---

<BaseLayout title="Waivers" currentPath="/waivers">
  <PageHero title="Waivers" />

  <section class="section">
    <div class="container container--narrow legal-page">
      <p>
        Waivers are completed digitally during
        <a href="/trial/">free trial sign-up</a>. Below are the current documents for your records.
      </p>

      <h2>Liability waiver</h2>
      <div class="legal-scroll" style="max-height: none">
        {waiverText.split('\n').map((line) => (
          <p>{line}</p>
        ))}
      </div>

      <h2>Photo release</h2>
      <div class="legal-scroll" style="max-height: none">
        {photoReleaseText.split('\n').map((line) => (
          <p>{line}</p>
        ))}
      </div>

      <p style="margin-top: 2rem">
        <a href="/trial/" class="btn btn--primary">Sign up for a free trial</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page h2 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }
</style>
