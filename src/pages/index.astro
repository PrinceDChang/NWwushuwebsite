---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import InstagramSection from '../components/InstagramSection.astro';
import { site } from '../data/site';

const heroVideoId = 'Q32L4Rx_040';
const heroVideoPoster = `https://i.ytimg.com/vi/${heroVideoId}/maxresdefault.jpg`;
---

<BaseLayout title={site.shortName} currentPath="/">
  <section class="home-hero">
    <div class="home-hero__video" aria-hidden="true">
      <video
        class="home-hero__media"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroVideoPoster}
      >
        <source src="/videos/hero-showreel.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <h1 class="home-hero__title">Northwest Wushu</h1>
      <p class="home-hero__tagline">{site.tagline}</p>
      <p class="home-hero__intro">
        New to wushu? We welcome kids, teens, and adults — no experience needed. Your first class is
        free.
      </p>
      <div class="home-hero__actions">
        <a href="/trial/" class="btn btn--primary">Try your first class for free</a>
        <a href="/about/#what-is-wushu" class="btn btn--secondary">Learn more</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="features">
        <div class="feature">
          <FeatureIcon variant="levels" />
          <h2 class="feature__title">All Levels Welcome</h2>
          <p>From first-timers to competitive athletes.</p>
        </div>
        <div class="feature">
          <FeatureIcon variant="tradition" />
          <h2 class="feature__title">Traditional &amp; Modern</h2>
          <p>Shanxi team methods through modern wushu training.</p>
        </div>
        <div class="feature">
          <FeatureIcon variant="location" />
          <h2 class="feature__title">Seattle Location</h2>
          <p>{site.address.street}, {site.address.name}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container home-split">
      <div class="home-split__media">
        <img
          src="/images/wushu-seattle-skyline.jpg"
          alt="Wushu practitioner with staff on a hill overlooking the Seattle skyline at sunrise"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="section__title">What is Wushu?</h2>
        <p>
          Wushu is a modern, standardized form of Chinese martial arts that combines traditional
          combat techniques with athletic movement and acrobatics. Training builds strength,
          flexibility, coordination, and discipline for all ages.
        </p>
        <div class="home-split__cta">
          <a href="/about/#what-is-wushu" class="btn btn--primary">Read more on our About page →</a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />

  <section class="section section--alt" id="instagram" aria-labelledby="instagram-heading">
    <div class="container">
      <h2 id="instagram-heading" class="section__title text-center">Follow us on Instagram</h2>
      <InstagramSection limit={6} />
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-hero-bg);
    color: #fff;
    padding: 4rem 0;
    min-height: clamp(22rem, 52vh, 32rem);
    display: flex;
    align-items: center;
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--color-hero-bg);
    background-size: cover;
    background-position: center;
  }

  .home-hero__media {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%) scale(1.08);
    border: 0;
    pointer-events: none;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(26 21 32 / 0.45),
      rgb(17 24 39 / 0.78)
    );
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__video {
      display: none;
    }
  }

  .home-hero__title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin-bottom: 0.5rem;
  }

  .home-hero__tagline {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .home-hero__intro {
    margin-bottom: 1.5rem;
    opacity: 0.95;
  }

  .home-hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-cta__lead {
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 1.5rem;
  }

  .feature__title {
    font-size: 1.125rem;
    margin-bottom: 0.35rem;
  }

  .home-split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .home-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .home-split__media img {
    border-radius: var(--radius-lg);
    width: 100%;
    object-fit: cover;
  }

  .home-split__cta {
    margin-top: 1.25rem;
  }
</style>
