---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.shortName} currentPath="/">
  <section class="home-hero">
    <div class="container home-hero__inner">
      <h1 class="home-hero__title">Northwest Wushu</h1>
      <p class="home-hero__tagline">{site.tagline}</p>
      <p class="home-hero__intro">
        New to wushu? We welcome kids, teens, and adults — no experience needed. Your first class is
        free.
      </p>
      <div class="home-hero__actions">
        <a href="/trial/" class="btn btn--primary">Try your first class for free</a>
        <a href="/about/#what-is-wushu" class="btn btn--secondary">Learn more</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="features">
        <div class="feature">
          <div class="feature__icon" aria-hidden="true">◎</div>
          <h2 class="feature__title">All Levels Welcome</h2>
          <p>From first-timers to competitive athletes.</p>
        </div>
        <div class="feature">
          <div class="feature__icon" aria-hidden="true">✦</div>
          <h2 class="feature__title">Traditional &amp; Modern</h2>
          <p>Shanxi team methods through modern wushu training.</p>
        </div>
        <div class="feature">
          <div class="feature__icon" aria-hidden="true">⌖</div>
          <h2 class="feature__title">Seattle Location</h2>
          <p>{site.address.street}, {site.address.name}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container home-split">
      <div class="home-split__media">
        <img
          src="/images/class-kids.jpg"
          alt="Kids wushu class practicing together on red mats"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="section__title">What is Wushu?</h2>
        <p>
          Wushu is a modern, standardized form of Chinese martial arts that combines traditional
          combat techniques with athletic movement and acrobatics. Training builds strength,
          flexibility, coordination, and discipline for all ages.
        </p>
        <p>
          <a href="/about/#what-is-wushu">Read more on our About page →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container text-center">
      <h2 class="section__title">New here?</h2>
      <p class="text-muted" style="max-width: 36rem; margin-inline: auto 1.5rem">
        Parents: start with a free trial — we will confirm your Saturday spot within {site.replyTime}.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap">
        <a href="/trial/" class="btn btn--primary">Book free trial</a>
        <a href="/contact/" class="btn btn--ghost">Ask a question</a>
      </div>
    </div>
  </section>

  <CTABand />

  <section class="section section--alt" id="instagram" aria-labelledby="instagram-heading">
    <div class="container">
      <h2 id="instagram-heading" class="section__title text-center">Follow us on Instagram</h2>
      <p class="text-center text-muted">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle}</a>
      </p>
      <div class="instagram-embed">
        <!-- Replace src with your SnapWidget/Elfsight embed when ready -->
        <p>
          Live feed: add an embed from
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          (SnapWidget or Elfsight). See README.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    background: var(--color-hero-bg);
    color: #fff;
    padding: 4rem 0;
  }

  .home-hero__inner {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .home-hero__title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin-bottom: 0.5rem;
  }

  .home-hero__tagline {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .home-hero__intro {
    margin-bottom: 1.5rem;
    opacity: 0.95;
  }

  .home-hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .feature__title {
    font-size: 1.125rem;
    margin-bottom: 0.35rem;
  }

  .home-split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .home-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .home-split__media img {
    border-radius: var(--radius-lg);
    width: 100%;
    object-fit: cover;
  }
</style>
