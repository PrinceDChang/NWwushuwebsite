---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../data/site';
import { faqItems } from '../../data/faq';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID || 'your_contact_form_id';
const honeypot = import.meta.env.PUBLIC_FORMSPREE_HONEYPOT || '_gotcha';
---

<BaseLayout title="Contact" currentPath="/contact">
  <PageHero title="Contact Us" />

  <section class="section">
    <div class="container container--narrow">
      <p class="text-muted text-center" style="margin-bottom: 2rem">
        We typically reply within <strong>{site.replyTime}</strong>. For trial sign-ups, use our
        <a href="/trial/">free trial form</a> for faster scheduling.
      </p>

      <h2 class="section__title">Send a message</h2>
      <form id="contact-form" class="form-grid" data-formspree-id={formspreeId} novalidate>
        <input type="text" name={honeypot} tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <div class="form-grid form-grid--2">
          <div class="form-field">
            <label class="required" for="firstName">First name</label>
            <input id="firstName" name="first_name" required autocomplete="given-name" placeholder="Your first name" />
          </div>
          <div class="form-field">
            <label class="required" for="lastName">Last name</label>
            <input id="lastName" name="last_name" required autocomplete="family-name" placeholder="Your last name" />
          </div>
        </div>
        <div class="form-field">
          <label class="required" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="form-field">
          <label for="phone">Phone (optional)</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 (555) 000-0000" />
        </div>
        <div class="form-field">
          <label class="required" for="interest">Interest</label>
          <select id="interest" name="interest" required>
            <option value="Free Trial Class">Free Trial Class</option>
            <option value="General Question">General Question</option>
            <option value="Schedule / Classes">Schedule / Classes</option>
            <option value="Location / Directions">Location / Directions</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-field">
          <label class="required" for="message">Message</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Tell us about your experience level and goals…"></textarea>
        </div>
        <div class="form-actions form-actions--end">
          <button type="submit" class="btn btn--primary">Send message</button>
        </div>
      </form>

      <p class="text-center" style="margin-top: 2rem">
        Prefer Instagram?
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle}</a>
      </p>
    </div>
  </section>

  <FAQSection items={faqItems} variant="light" id="contact-faq" />
  <CTABand />
</BaseLayout>

<style>
  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }
</style>

<script type="module" src="/scripts/contact-form.js"></script>
