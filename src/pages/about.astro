---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import CoachFeatureTicker from '../components/CoachFeatureTicker.astro';
import { coaches } from '../data/coaches';
---

<BaseLayout title="About" description={`About ${site.name}`} currentPath="/about">
  <PageHero
    title="About Northwest Wushu"
    subtitle="Seattle's home for traditional Chinese martial arts since 2008."
    variant="image"
    imageSrc="/images/about-group-outdoor.jpg"
    imagePosition="center 60%"
  />

  <nav class="about-subnav" aria-label="About sections">
    <div class="container">
      <a href="#what-is-wushu">Wushu</a>
      <a href="#coaches">Coaches</a>
      <a href="#programs">Programs</a>
    </div>
  </nav>

  <section class="section" id="what-is-wushu">
    <div class="container about-split">
      <div class="about-split__media">
        <img
          src="/images/studio-training.jpg"
          alt="Instructor guiding a student with a staff in the training studio"
          width="500"
          height="600"
          loading="lazy"
        />
      </div>
      <div class="about-split__content">
        <h2 class="section__title">What is Wushu</h2>
        <p>
          Wushu is a modern, standardized form of Chinese martial arts that combines traditional
          combat techniques with athletic movement and acrobatics. Students develop strength,
          flexibility, coordination, and discipline.
        </p>
        <p>
          At Northwest Wushu Academy, we train kids, teens, and adults in a supportive community at
          the Seattle Armory. Whether you are exploring martial arts for fitness, culture, or
          competition, you are welcome here.
        </p>
        <p class="text-muted">(Additional history and forms content — placeholder for approved copy.)</p>
      </div>
    </div>
  </section>

  <section class="section coaches-banner" id="coaches" aria-labelledby="coaches-heading">
    <div class="container">
      <h2 id="coaches-heading" class="coaches-banner__title">Coaches</h2>
    </div>
  </section>

  <section class="section">
    <CoachFeatureTicker />

    <div class="container coach-grid">
      {
        coaches.map((coach) => (
          <article class="coach-card">
            {coach.image && (
              <div class="coach-card__media">
                <img
                  src={coach.image}
                  alt={coach.name}
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="coach-card__body">
              {coach.role && <p class="coach-role-label">{coach.role}</p>}
              <h3 class="coach-card__name">{coach.name}</h3>
              <p>{coach.bio}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="programs-showcase" id="programs" aria-labelledby="programs-heading">
    <svg class="programs-showcase__defs" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="programs-photo-arc" clipPathUnits="objectBoundingBox">
          <path d="M0,0 H1 V0.76 Q0.5,1 0,0.76 Z"></path>
        </clipPath>
      </defs>
    </svg>
    <div class="programs-showcase__bg" aria-hidden="true">
      <div class="programs-showcase__media-clip">
        <div class="programs-showcase__bg-parallax" data-programs-parallax>
          <img
            src="/images/programs-group.png"
            alt=""
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="programs-showcase__overlay"></div>
      </div>
      <div class="programs-showcase__white-floor"></div>
    </div>

    <div class="container programs-showcase__inner">
      <header class="programs-showcase__header" data-programs-reveal>
        <h2 id="programs-heading" class="programs-showcase__title">Our Programs</h2>
        <p class="programs-showcase__lead">
          Training for kids, teens, and adults at the Seattle Armory — from first steps in wushu to
          forms, weapons, and competition-ready conditioning.
        </p>
      </header>

      <div class="programs-showcase__cards">
        <article class="program-card" data-programs-reveal>
          <img
            src="/images/class-kids.jpg"
            alt="Kids wushu class practicing together on red mats"
            width="600"
            height="400"
            loading="lazy"
          />
          <h3>Kids Class</h3>
          <p>
            Saturday 10:00–11:00 AM · Ages 6–12. Foundations, coordination, and confidence in a
            supportive group setting.
          </p>
          <a href="/trial/?class=kids" class="btn btn--primary btn--small">Sign up for free trial</a>
        </article>

        <article class="program-card" data-programs-reveal>
          <img
            src="/images/class-teens-adults.jpg"
            alt="Teen and adult class stretching on the training floor"
            width="600"
            height="400"
            loading="lazy"
          />
          <h3>Teen &amp; Adult</h3>
          <p>
            Saturday 11:00 AM–1:00 PM · Ages 13+. Forms, weapons, and conditioning for beginners
            through experienced athletes.
          </p>
          <a href="/trial/?class=adult" class="btn btn--primary btn--small">Sign up for free trial</a>
        </article>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const section = document.querySelector('.programs-showcase');
      if (!section) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parallaxLayer = section.querySelector('[data-programs-parallax]');
      const revealEls = Array.from(section.querySelectorAll('[data-programs-reveal]'));

      if (!reduceMotion) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-inview');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-inview'));
      }

      if (reduceMotion || !parallaxLayer) return;

      let raf = 0;
      const onScroll = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight || 1;
          const total = rect.height + vh;
          const passed = vh - rect.top;
          const progress = Math.min(1, Math.max(0, passed / total));
          const maxShift = Math.max(140, rect.height * 0.28);
          const offset = maxShift - progress * 2 * maxShift;
          const img = parallaxLayer.querySelector('img');
          if (img) {
            img.style.transform = `translate3d(0, calc(-20% + ${offset}px), 0)`;
          }
        });
      };

      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      document.addEventListener('astro:page-load', onScroll);
    })();
  </script>

  <CTABand />
</BaseLayout>

<style>
  .about-subnav {
    background: linear-gradient(180deg, var(--color-surface-alt) 0%, var(--color-surface) 100%);
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .about-subnav .container {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .about-subnav a {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border-radius: var(--radius-pill);
    transition:
      color 0.2s ease,
      background 0.25s var(--ease-out);
  }

  .about-subnav a:hover {
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.8);
    box-shadow: var(--shadow-sm);
  }

  .about-split {
    display: grid;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .about-split {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .about-split__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    min-height: 16rem;
  }

  .about-split__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .coaches-banner {
    background: var(--gradient-brand);
    color: #fff;
    padding: 2.5rem 0;
  }

  .coaches-banner__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
  }

  .coach-grid {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .coach-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    width: min(100%, 42rem);
    max-width: 50%;
    gap: 1rem;
    padding: 1.25rem;
    overflow: visible;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .coach-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .coach-card__media {
    position: relative;
    width: 100%;
    max-width: 12.5rem;
    aspect-ratio: 3 / 4;
    justify-self: start;
    align-self: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .coach-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    border-radius: var(--radius-lg);
  }

  .coach-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 0.25rem 0 0;
    min-height: 0;
  }

  .coach-card__name {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .coach-card__body p:not(.coach-role-label) {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .coach-card {
      max-width: 100%;
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .coach-card {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .coach-card__media {
      max-width: 12.5rem;
      margin-inline: auto;
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coach-card {
      transition: none;
    }

    .coach-card:hover {
      transform: none;
    }
  }

  /* Programs — full-bleed parallax background + cards on top */
  .programs-showcase {
    --programs-arc-depth: clamp(3.5rem, 8vw, 5.5rem);
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 5rem) 0 clamp(4.5rem, 10vw, 6rem);
    margin-top: 0;
    background: #fff;
  }

  .programs-showcase__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .programs-showcase__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Photo + gradient clipped with a soft arc at the bottom */
  .programs-showcase__media-clip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: calc(33.333% - var(--programs-arc-depth));
    overflow: hidden;
    clip-path: url(#programs-photo-arc);
  }

  .programs-showcase__bg-parallax {
    position: absolute;
    left: 0;
    right: 0;
    top: -32%;
    height: 165%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 2%;
    will-change: transform;
    background: rgb(26 21 32 / 0.25);
  }

  .programs-showcase__bg-parallax img {
    width: 100%;
    height: 105%;
    object-fit: contain;
    object-position: center 68%;
    display: block;
    transform: translateY(-20%);
  }

  .programs-showcase__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        135deg,
        rgb(15 20 25 / 0.55) 0%,
        rgb(15 20 25 / 0.2) 50%,
        rgb(15 20 25 / 0.35) 100%
      ),
      var(--gradient-brand);
    opacity: 0.82;
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 88%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 88%);
  }

  .programs-showcase__white-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(33.333% + var(--programs-arc-depth));
    background: #fff;
    z-index: 0;
    clip-path: polygon(0% 14%, 50% 0%, 100% 14%, 100% 100%, 0% 100%);
  }

  .programs-showcase__inner {
    position: relative;
    z-index: 1;
  }

  .programs-showcase__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2rem, 5vw, 3rem);
    color: #fff;
    transform: translateY(16px);
    opacity: 0;
    transition:
      transform 0.75s var(--ease-out),
      opacity 0.75s var(--ease-out);
  }

  .programs-showcase__header.is-inview {
    transform: translateY(0);
    opacity: 1;
  }

  .programs-showcase__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #fff;
  }

  .programs-showcase__lead {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.0625rem);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.92);
  }

  .programs-showcase__cards {
    display: grid;
    gap: 1.25rem;
    max-width: 56rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .programs-showcase__cards {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .program-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    box-shadow:
      0 2px 4px rgb(15 20 25 / 0.04),
      0 10px 24px rgb(15 20 25 / 0.1),
      0 20px 48px rgb(185 21 20 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.65);
    transform: translateY(20px);
    opacity: 0;
    transition:
      transform 0.8s var(--ease-out),
      opacity 0.8s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .program-card.is-inview {
    transform: translateY(0);
    opacity: 1;
  }

  .program-card:nth-child(2) {
    transition-delay: 0.1s;
  }

  .program-card:hover {
    box-shadow:
      0 4px 8px rgb(15 20 25 / 0.06),
      0 16px 32px rgb(15 20 25 / 0.14),
      0 28px 56px rgb(185 21 20 / 0.12);
    transform: translateY(-4px);
  }

  .program-card.is-inview:hover {
    transform: translateY(-4px);
  }

  .program-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: 1rem;
    display: block;
  }

  .program-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .program-card p {
    margin: 0 0 1.125rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .programs-showcase__header,
    .program-card {
      transform: none;
      opacity: 1;
      transition: none;
    }

    .programs-showcase__bg-parallax {
      top: -20%;
      height: 140%;
    }

    .programs-showcase__bg-parallax img {
      transform: translateY(-16%);
    }
  }
</style>
