---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
---

<BaseLayout title="Location" currentPath="/location">
  <PageHero title="Location" subtitle={site.address.full} />

  <section class="section">
    <div class="container">
      <div class="map-wrap">
        <iframe
          title="Map to Seattle Armory"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2689.589!2d-122.350!3d47.621!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54901545d8808c69%3A0x7c8f5f5f5f5f5f5f!2s305%20Harrison%20St%2C%20Seattle%2C%20WA%2098109!5e0!3m2!1sen!2sus!4v1"
          width="100%"
          height="400"
          style="border:0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="text-center" style="margin-top: 1rem">
        <a href={site.mapsLink} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Our Training Space</h2>
      <div class="location-split">
        <div class="location-placeholder" role="img" aria-label="Studio interior photo coming soon">
          <p>Interior photos coming soon</p>
        </div>
        <ul class="location-tips">
          <li>
            <strong>Parking</strong> — Free street parking is often available nearby. Paid garages
            near Seattle Center are an option on busy days.
          </li>
          <li>
            <strong>Getting here</strong> — The Armory is in the Seattle Center area, accessible by
            Monorail, bus, and rideshare. Allow extra time during events.
          </li>
          <li>
            <strong>When you arrive</strong> — Check in with your coach and follow posted studio
            rules (e.g. shoes off the mats).
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .location-split {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .location-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .location-placeholder {
    background: var(--color-border);
    border-radius: var(--radius-lg);
    min-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
  }

  .location-tips {
    padding-left: 1.25rem;
  }

  .location-tips li + li {
    margin-top: 1rem;
  }
</style>
