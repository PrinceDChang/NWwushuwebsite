---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';

const locations = [site.locations.regular, site.locations.summer];
---

<BaseLayout title="Location" currentPath="/location">
  <nav class="location-tabs" aria-label="Training locations">
    <div class="container location-tabs__inner" role="tablist" aria-label="Regular or summer location">
      {
        locations.map((location, index) => (
          <button
            type="button"
            class="location-tabs__tab"
            role="tab"
            id={`location-tab-${location.id}`}
            aria-controls={`location-panel-${location.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-location={location.id}
            data-address={location.full}
          >
            {location.label}
          </button>
        ))
      }
    </div>
  </nav>

  <PageHero
    title="Location"
    subtitle={site.locations.regular.full}
    subtitleId="location-hero-address"
    variant="image"
    imageSrc="/images/location-seattle-skyline.png"
    imageAlt="Seattle skyline with the Space Needle at sunset"
    imagePosition="center 25%"
    imageParallax
    heroScale={1.25}
  />

  {
    locations.map((location, index) => (
      <div
        class:list={['location-panel', index === 0 && 'location-panel--active']}
        id={`location-panel-${location.id}`}
        role="tabpanel"
        aria-labelledby={`location-tab-${location.id}`}
        hidden={index !== 0 ? true : undefined}
      >
        <section class="section">
          <div class="container">
            <div class="map-wrap">
              <iframe
                title={location.mapsTitle}
                src={location.mapsEmbed}
                width="100%"
                height="400"
                style="border:0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </section>

        <section class="section section--alt">
          <div class="container">
            <h2 class="section__title">{location.spaceTitle}</h2>
            <div class="location-split">
              <div class="location-split__media">
                <img
                  src={location.imageSrc}
                  alt={location.imageAlt}
                  width="800"
                  height="600"
                  loading="lazy"
                />
              </div>
              <ul class="location-tips">
                {location.tips.map((tip) => (
                  <li>
                    <strong>{tip.title}</strong> — {tip.text}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      </div>
    ))
  }

  <CTABand />
</BaseLayout>

<script is:inline>
(() => {
  const init = () => {
    const tabs = Array.from(document.querySelectorAll('[data-location]'));
    const panels = Array.from(document.querySelectorAll('.location-panel'));
    const address = document.getElementById('location-hero-address');
    if (!tabs.length || !panels.length) return;

    const setLocation = (id, { updateHash = true } = {}) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.location === id;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && address) address.textContent = tab.dataset.address || '';
      });

      panels.forEach((panel) => {
        const active = panel.id === 'location-panel-' + id;
        panel.hidden = !active;
        panel.classList.toggle('location-panel--active', active);
      });

      if (updateHash) {
        const url = new URL(window.location.href);
        url.hash = id === 'regular' ? '' : id;
        history.replaceState(null, '', url);
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setLocation(tab.dataset.location));
    });

    const tablist = document.querySelector('.location-tabs__inner');
    tablist?.addEventListener('keydown', (event) => {
      const current = tabs.indexOf(document.activeElement);
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;
      if (next === current) return;

      event.preventDefault();
      tabs[next].focus();
      setLocation(tabs[next].dataset.location);
    });

    const fromHash = window.location.hash.replace('#', '');
    const initial = tabs.some((tab) => tab.dataset.location === fromHash) ? fromHash : 'regular';
    setLocation(initial, { updateHash: false });
  };

  init();
  document.addEventListener('astro:page-load', init);
})();
</script>

<style>
  .location-tabs {
    background: linear-gradient(180deg, var(--color-surface-alt) 0%, var(--color-surface) 100%);
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .location-tabs__inner {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .location-tabs__tab {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    background: transparent;
    border: 1px solid transparent;
    padding: 0.5rem 1.125rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .location-tabs__tab:hover {
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.8);
    box-shadow: var(--shadow-sm);
  }

  .location-tabs__tab[aria-selected='true'] {
    color: var(--color-brand-dark);
    background: var(--gradient-brand-soft);
    border-color: rgb(229 154 77 / 0.28);
    box-shadow: var(--shadow-sm);
  }

  .location-panel {
    display: none;
  }

  .location-panel--active {
    display: block;
  }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .location-split {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .location-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .location-split__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
  }

  .location-split__media img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .location-tips {
    padding-left: 1.25rem;
  }

  .location-tips li + li {
    margin-top: 1rem;
  }
</style>
