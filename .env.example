# Contact API (Resend + Cloudflare Worker)
# Deploy workers/contact-api first, then paste the Worker URL here (no trailing slash).
PUBLIC_CONTACT_API_URL=your_contact_api_url

# Optional: honeypot field name for spam bots
PUBLIC_CONTACT_HONEYPOT=_gotcha

# Trial signup still uses Formspree (optional)
PUBLIC_FORMSPREE_TRIAL_ID=your_trial_form_id
