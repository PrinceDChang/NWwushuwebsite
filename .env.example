# Formspree form IDs — create forms at https://formspree.io
# Contact form → notify northwestwushu.2008@gmail.com + enable auto-reply
PUBLIC_FORMSPREE_CONTACT_ID=your_contact_form_id

# Trial signup form → same inbox + auto-reply template
PUBLIC_FORMSPREE_TRIAL_ID=your_trial_form_id

# Optional: honeypot field name (Formspree supports _gotcha)
PUBLIC_FORMSPREE_HONEYPOT=_gotcha
